# ============================================================
# GitHub AI Automation Bot - Environment Variables
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- GitHub ---
# Personal Access Token or GitHub App token
# Required scopes: repo, issues, pull_requests
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Webhook secret (set this when configuring webhook on GitHub)
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key

# (Optional) Limit to specific repos: "owner/repo1,owner/repo2"
ALLOWED_REPOSITORIES=

# --- AI Provider Configuration ---
# By default, the bot uses the standard OpenAI SDK format, allowing you to use 
# any compatible provider (OpenAI, Groq, OpenRouter, etc.).

# 1. Google Gemini (via AI Studio compatible endpoint)
# AI_API_KEY=your_gemini_api_key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-1.5-flash

# 2. Groq (Very Fast, Free Tier)
# AI_API_KEY=gsk_your_groq_api_key
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# 3. OpenRouter (Free models available)
# AI_API_KEY=sk-or-v1-your_openrouter_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3-8b-instruct:free

# 4. OpenAI (Default)
# AI_API_KEY=sk-your_openai_api_key_here
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Bot Behavior ---
# Add a comment when an issue is opened?
AUTO_COMMENT_ON_ISSUE=true
# Add a comment when a PR is opened?
AUTO_COMMENT_ON_PR=true
# Auto-apply labels?
AUTO_LABEL=true
